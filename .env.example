# Spent - Personal Finance Tracker
# Copy this file to .env and fill in your values.
# This file is committed to git as a template. Never commit .env itself.

# Optional: Override the default host/port for the dev server
# HOST=127.0.0.1
# PORT=3000

# Optional: Override the database directory (defaults to <repo>/data/).
# Set this to a timestamped sandbox directory for mutation QA so the live DB
# is never touched. The app reads/writes spent.db inside this directory.
#
# Quickstart:
#   SPENT_DATA_DIR=$(./scripts/qa-sandbox.sh) npm run dev
#
# The sandbox script copies the live DB to data/tmp/qa-<timestamp>/ and prints
# the path. Clean up with: rm -rf data/tmp/qa-*
#
# SPENT_DATA_DIR=
